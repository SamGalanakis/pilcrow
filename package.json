{
  "name": "pilcrow-ink",
  "version": "0.17.1",
  "description": "Make your clanker your editor. A prose linter plus nine interpretive lenses anchored in classical style guides plus four project commands for voice capture and drafting. Catches AI tells as one feature among many.",
  "license": "MIT",
  "author": "Samuel Galanakis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamGalanakis/pilcrow.git"
  },
  "homepage": "https://pilcrow.ink",
  "keywords": [
    "writing",
    "prose",
    "ai",
    "ai-slop",
    "skills",
    "anti-patterns",
    "lint",
    "ci-cd",
    "editor"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "pilcrow": "cli/dist/index.js"
  },
  "main": "engine/dist/index.js",
  "exports": {
    ".": "./engine/dist/index.js"
  },
  "files": [
    "cli/dist",
    "engine/dist",
    "skills/pilcrow",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build:genre-rules": "node skills/pilcrow/scripts/build-genre-rules.mjs",
    "build:engine": "npm run build:genre-rules && tsc -p engine",
    "build:cli": "tsc -p cli",
    "build": "npm run build:engine && npm run build:cli",
    "build:docs": "node scripts/build-rules-page.mjs && node scripts/build-genres-page.mjs",
    "build:cowork": "node scripts/build-cowork-zip.mjs",
    "test": "vitest run",
    "prepack": "npm run build",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
